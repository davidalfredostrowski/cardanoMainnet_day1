  200  vi contract.js
  201  node -e "
import('./lucid.js').then(async ({getLucid}) => {
  const { getScriptAddress } = await import('./contract.js');
  const { Data } = await import('@lucid-evolution/lucid');

  const lucid = await getLucid();
  const address = getScriptAddress();
  const utxos = await lucid.utxosAt(address);

  console.log('UTXO count:', utxos.length);

  for (const u of utxos) {
    console.log('\n----------------');
    console.log(u.txHash + '#' + u.outputIndex);
    console.log('assets:', u.assets);
    console.log('datum:', u.datum);

    if (u.datum) {
      try {
        console.dir(Data.from(u.datum), {depth:null});
      } catch (e) {
        console.log('Datum decode failed:', e.message);
      }
    }
  }
})
"
